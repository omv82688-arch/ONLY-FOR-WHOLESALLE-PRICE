<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Verma Kiran Store - Quality Oil at the Right Price.">
  <title>Verma Kiran Store | Quality Oil at the Right Price</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: #351064;
      color: white;
      padding: 20px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    header h1 {
      font-size: 25px;
    }

    header p {
      color: #eee0ff;
      font-size: 14px;
    }

    .cart-button {
      background: #ffcb45;
      color: #24103a;
      padding: 10px 16px;
      border: none;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
    }

    .hero {
      background: linear-gradient(135deg, #4b1680, #7b36ba);
      color: white;
      padding: 55px 20px;
      text-align: center;
    }

    .hero h2 {
      font-size: 34px;
      margin-bottom: 12px;
    }

    .hero p {
      margin-bottom: 20px;
    }

    .hero a {
      display: inline-block;
      background: #ffcb45;
      color: #24103a;
      text-decoration: none;
      padding: 12px 22px;
      border-radius: 8px;
      font-weight: bold;
    }

    .container {
      width: 92%;
      max-width: 1150px;
      margin: 35px auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 25px;
      color: #351064;
      font-size: 28px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 22px;
    }

    .product {
      background: white;
      border-radius: 12px;
      padding: 20px;
      text-align: center;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
    }

    .product-icon {
      font-size: 65px;
      margin-bottom: 12px;
    }

    .product h3 {
      color: #351064;
      margin-bottom: 8px;
    }

    .product p {
      color: #666;
      font-size: 14px;
      margin-bottom: 10px;
    }

    .price {
      font-size: 22px;
      font-weight: bold;
      color: #16833c;
      margin: 12px 0;
    }

    .product button {
      width: 100%;
      padding: 11px;
      border: none;
      border-radius: 7px;
      background: #351064;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    .product button:hover {
      background: #542092;
    }

    .cart-section {
      background: white;
      padding: 25px;
      border-radius: 12px;
      margin-top: 35px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    }

    .cart-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding: 12px 0;
      border-bottom: 1px solid #eee;
      flex-wrap: wrap;
    }

    .quantity {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .quantity button {
      padding: 4px 10px;
      cursor: pointer;
    }

    .remove-button {
      color: #c62828;
      border: none;
      background: transparent;
      cursor: pointer;
    }

    .order-button {
      display: block;
      width: 100%;
      padding: 14px;
      margin-top: 20px;
      background: #16833c;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .contact {
      text-align: center;
      background: #eee5f8;
      padding: 30px 15px;
      margin-top: 40px;
    }

    footer {
      background: #24103a;
      color: white;
      text-align: center;
      padding: 20px;
      font-size: 14px;
    }

    @media (max-width: 600px) {
      header {
        justify-content: center;
        text-align: center;
      }

      .hero h2 {
        font-size: 27px;
      }

      .section-title {
        font-size: 24px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div>
      <h1>Verma Kiran Store</h1>
      <p>Quality Oil at the Right Price</p>
    </div>

    <button class="cart-button" onclick="showCart()">
      🛒 Cart (<span id="cart-count">0</span>)
    </button>
  </header>

  <section class="hero">
    <h2>आपकी रसोई का भरोसेमंद स्टोर</h2>
    <p>अच्छी क्वालिटी का कुकिंग ऑयल, सही कीमत पर।</p>
    <a href="#products">अभी खरीदें</a>
  </section>

  <main class="container">
    <h2 class="section-title" id="products">हमारे प्रोडक्ट्स</h2>

    <div class="products" id="product-list"></div>

    <section class="cart-section" id="cart">
      <h2>🛒 आपका शॉपिंग कार्ट</h2>
      <div id="cart-items">
        <p style="margin-top:15px;">आपका कार्ट अभी खाली है।</p>
      </div>

      <h3 style="margin-top:20px;">
        कुल राशि: ₹<span id="cart-total">0</span>
      </h3>

      <button class="order-button" onclick="placeOrder()">
        WhatsApp पर ऑर्डर करें
      </button>
    </section>
  </main>

  <section class="contact">
    <h2>Verma Kiran Store</h2>
    <p>थोक एवं रिटेल कुकिंग ऑयल के लिए संपर्क करें।</p>
    <p>कीमत और उपलब्धता ऑर्डर से पहले कन्फर्म करें।</p>
  </section>

  <footer>
    <p>© <span id="year"></span> Verma Kiran Store. All Rights Reserved.</p>
    <p>Quality Oil at the Right Price</p>
  </footer>

  <script>
    // अपनी वास्तविक कीमतें यहाँ भरें।
    // नीचे दी गई कीमतें केवल डेमो के लिए हैं।

    const products = [
      {
        id: 1,
        name: "Fortune Soyabean Oil",
        size: "1 लीटर",
        price: 150,
        icon: "🛢️"
      },
      {
        id: 2,
        name: "Ruchi Gold Soyabean Oil",
        size: "1 लीटर",
        price: 145,
        icon: "🛢️"
      },
      {
        id: 3,
        name: "Abse Gold Soyabean Oil",
        size: "1 लीटर",
        price: 140,
        icon: "🛢️"
      },
      {
        id: 4,
        name: "Mahakosh Soyabean Oil",
        size: "1 लीटर",
        price: 148,
        icon: "🛢️"
      }
    ];

    const cart = {};

    function formatPrice(amount) {
      return amount.toLocaleString("en-IN");
    }

    function renderProducts() {
      const list = document.getElementById("product-list");

      list.innerHTML = products.map(product => `
        <article class="product">
          <div class="product-icon">${product.icon}</div>
          <h3>${product.name}</h3>
          <p>पैक साइज: ${product.size}</p>
          <p>अच्छी क्वालिटी का कुकिंग ऑयल</p>
          <div class="price">₹${formatPrice(product.price)}</div>
          <button onclick="addToCart(${product.id})">
            कार्ट में जोड़ें
          </button>
        </article>
      `).join("");
    }

    function addToCart(id) {
      if (cart[id]) {
        cart[id]++;
      } else {
        cart[id] = 1;
      }

      renderCart();
    }

    function changeQuantity(id, change) {
      if (!cart[id]) return;

      cart[id] += change;

      if (cart[id] <= 0) {
        delete cart[id];
      }

      renderCart();
    }

    function removeItem(id) {
      delete cart[id];
      renderCart();
    }

    function renderCart() {
      const itemsContainer = document.getElementById("cart-items");
      let total = 0;
      let count = 0;

      const entries = Object.entries(cart);

      if (entries.length === 0) {
        itemsContainer.innerHTML =
          '<p style="margin-top:15px;">आपका कार्ट अभी खाली है।</p>';
      } else {
        itemsContainer.innerHTML = entries.map(([id, quantity]) => {
          const product = products.find(p => p.id === Number(id));
          const subtotal = product.price * quantity;

          total += subtotal;
          count += quantity;

          return `
            <div class="cart-item">
              <div>
                <strong>${product.name}</strong><br>
                ₹${formatPrice(product.price)} × ${quantity}
                = ₹${formatPrice(subtotal)}
              </div>

              <div class="quantity">
                <button onclick="changeQuantity(${product.id}, -1)">−</button>
                <span>${quantity}</span>
                <button onclick="changeQuantity(${product.id}, 1)">+</button>
                <button class="remove-button"
                  onclick="removeItem(${product.id})">
                  हटाएँ
                </button>
              </div>
            </div>
          `;
        }).join("");
      }

      document.getElementById("cart-total").textContent =
        formatPrice(total);

      document.getElementById("cart-count").textContent = count;
    }

    function showCart() {
      document.getElementById("cart").scrollIntoView({
        behavior: "smooth"
      });
    }

    function placeOrder() {
      const entries = Object.entries(cart);

      if (entries.length === 0) {
        alert("कृपया पहले कार्ट में प्रोडक्ट जोड़ें।");
        return;
      }

      let total = 0;
      let message = "Namaste Verma Kiran Store! Mujhe ye order karna hai:%0A%0A";

      entries.forEach(([id, quantity]) => {
        const product = products.find(p => p.id === Number(id));
        const subtotal = product.price * quantity;
        total += subtotal;

        message += encodeURIComponent(
          product.name + " (" + product.size + ") × " + quantity +
          " = ₹" + subtotal
        ) + "%0A";
      });

      message += "%0A" + encodeURIComponent("Total: ₹" + total);
      message += "%0A%0A" + encodeURIComponent(
        "Please confirm price, availability and delivery charges."
      );

      // नीचे 91 के बाद अपना 10 अंकों का WhatsApp नंबर लिखें।
      // उदाहरण: const phone = "919876543210";
      const phone = "";

      if (!/^[0-9]{10,15}$/.test(phone)) {
        alert(
          "ऑर्डर सुविधा चालू करने के लिए कोड में अपना WhatsApp नंबर भरें।"
        );
        return;
      }

      window.open(
        "https://wa.me/" + phone + "?text=" + message,
        "_blank"
      );
    }

    document.getElementById("year").textContent =
      new Date().getFullYear();

    renderProducts();
    renderCart();
  </script>

</body>
</html>
